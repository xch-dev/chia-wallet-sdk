      "for_expiry_pricing_registration": {
        "type": "factory",
        "args": {
          "handle": "String",
          "secret": "Bytes32",
          "owner_launcher_id": "Bytes32",
          "resolved_launcher_id": "Bytes32",
          "payment_asset_id": "Bytes32",
          "base_price": "u64",
