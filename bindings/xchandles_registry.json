    "type": "class",
    "new": true,
    "fields": {
      "left_slot": "XchandlesHandleSlot",
      "right_slot": "XchandlesHandleSlot"
    }
  },
  "XchandlesRegistry": {
    "type": "class",
    "methods": {
      "coin": {
        "return": "Coin"
      },
      "proof": {
        "return": "Proof"
      },
      "state": {
        "return": "XchandlesRegistryState"
      },
      "constants": {
        "return": "XchandlesConstants"
      },
      "inner_puzzle_hash": {
        "return": "TreeHash"
      },
      "puzzle_hash": {
        "return": "TreeHash"
      },
      "pending_created_handle_slots": {
        "return": "Vec<XchandlesHandleSlot>"
      },
      "pending_created_update_slots": {
        "return": "Vec<XchandlesUpdateSlot>"
      },
      "pending_signature": {
        "return": "Signature"
      },
      "finish_spend": {
        "return": "XchandlesRegistryFinishedSpendResult"
      },
      "register": {
        "args": {
          "left_slot": "XchandlesHandleSlot",
          "right_slot": "XchandlesHandleSlot",
          "precommit_coin": "XchandlesPrecommitCoin",
          "base_handle_price": "u64",
          "registration_period": "u64",
          "start_time": "u64",
          "owner_inner_puzzle_hash": "Bytes32",
          "resolved_inner_puzzle_hash": "Bytes32"
        },
        "return": "XchandlesTripleConditionsResult"
      },
      "refund_with_pricing": {
        "args": {
          "precommit_coin": "XchandlesPrecommitCoin",
          "pricing_puzzle_reveal": "Program",
          "pricing_puzzle_solution": "Program",
          "slot": "Option<XchandlesHandleSlot>"
        },
        "return": "Vec<Program>"
      },
      "refund": {
        "args": {
          "precommit_coin": "XchandlesPrecommitCoin",
          "slot": "Option<XchandlesHandleSlot>"
        },
        "return": "Vec<Program>"
      },
      "extend": {
        "args": {
          "handle": "String",
          "slot": "XchandlesHandleSlot",
          "payment_asset_id": "Bytes32",
          "base_handle_price": "u64",
          "registration_period": "u64",
          "num_periods": "u64",
          "buy_time": "u64"
        },
        "return": "XchandlesExtendResult"
      },
      "expire": {
        "args": {
          "slot": "XchandlesHandleSlot",
          "num_periods": "u64",
          "base_handle_price": "u64",
          "registration_period": "u64",
          "precommit_coin": "XchandlesPrecommitCoin",
          "start_time": "u64",
          "new_owner_inner_puzzle_hash": "Bytes32",
          "new_resolved_inner_puzzle_hash": "Bytes32"
        },
        "return": "XchandlesTripleConditionsResult"
      },
      "oracle": {
        "args": {
          "slot": "XchandlesHandleSlot"
        },
        "return": "Vec<Program>"
      },
      "initiate_update": {
        "args": {
          "slot": "XchandlesHandleSlot",
          "new_owner_launcher_id": "Bytes32",
          "new_resolved_launcher_id": "Bytes32",
          "current_owner": "CompactCoinProof",
          "min_height": "u32"
        },
        "return": "Vec<Program>"
      },
      "execute_update": {
        "args": {
          "handle_slot": "XchandlesHandleSlot",
          "update_slot": "XchandlesUpdateSlot",
          "new_owner_launcher_id": "Bytes32",
          "new_resolved_launcher_id": "Bytes32",
          "current_owner": "CompactCoinProof",
          "new_owner_inner_puzzle_hash": "Bytes32",
          "new_resolved_inner_puzzle_hash": "Bytes32"
        },
        "return": "XchandlesExecuteUpdateResult"
      },
      "delegated_state": {
        "args": {
          "new_state": "XchandlesRegistryState",
          "other_singleton_inner_puzzle_hash": "Bytes32"
        },
        "return": "Vec<Program>"
      },
      "actual_neighbors": {
        "args": {
          "new_handle_hash": "Bytes32",
          "on_chain_left_slot": "XchandlesHandleSlot",
          "on_chain_right_slot": "XchandlesHandleSlot"
        },
        "return": "XchandlesRegistryActualNeighborsResult"
      },
      "actual_handle_slot": {
        "args": {
          "slot": "XchandlesHandleSlot"
        },
        "return": "XchandlesHandleSlot"
      },
      "actual_update_slot": {
        "args": {
          "slot": "XchandlesUpdateSlot"
        },
        "return": "XchandlesUpdateSlot"
      },
      "parse_launcher_solution": {
        "type": "static",
        "args": {
          "launcher_coin": "Coin",
          "launcher_solution": "Program"
        },
        "return": "Option<XchandlesRegistryInfoFromLauncher>"
      }
    }
  },
  "singleton_struct_hash": {
    "type": "function",
