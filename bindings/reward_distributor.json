{
  "RewardDistributorType": {
    "type": "class",
    "methods": {
      "managed": {
        "type": "static",
        "args": {
          "manager_singleton_launcher_id": "Bytes32"
        },
        "return": "RewardDistributorType"
      },
      "nft_collection": {
        "type": "static",
        "args": {
          "collection_did_launcher_id": "Bytes32"
        },
        "return": "RewardDistributorType"
      },
      "curated_nft": {
        "type": "static",
        "args": {
          "store_launcher_id": "Bytes32",
          "refreshable": "bool"
        },
        "return": "RewardDistributorType"
      },
      "cat": {
        "type": "static",
        "args": {
          "asset_id": "Bytes32",
          "hidden_puzzle_hash": "Option<Bytes32>"
        },
        "return": "RewardDistributorType"
      }
    }
  },
  "RewardDistributorConstants": {
    "type": "class",
    "remote": true,
    "fields": {
      "launcher_id": "Bytes32",
      "fee_payout_puzzle_hash": "Bytes32",
      "epoch_seconds": "u64",
      "precision": "u64",
      "max_seconds_offset": "u64",
      "payout_threshold": "u64",
      "require_payout_approval": "bool",
      "fee_bps": "u64",
      "withdrawal_share_bps": "u64",
      "reserve_asset_id": "Bytes32",
      "reserve_inner_puzzle_hash": "Bytes32",
      "reserve_full_puzzle_hash": "Bytes32"
    },
    "methods": {
      "without_launcher_id": {
        "type": "factory",
        "args": {
          "reward_distributor_type": "RewardDistributorType",
          "fee_payout_puzzle_hash": "Bytes32",
          "epoch_seconds": "u64",
          "precision": "u64",
          "max_seconds_offset": "u64",
          "payout_threshold": "u64",
          "require_payout_approval": "bool",
          "fee_bps": "u64",
          "withdrawal_share_bps": "u64",
          "reserve_asset_id": "Bytes32"
        }
      },
      "with_launcher_id": {
        "args": {
          "launcher_id": "Bytes32"
        },
        "return": "RewardDistributorConstants"
      },
      "reward_distributor_type": {
        "return": "RewardDistributorType"
      }
    }
  },
  "RoundRewardInfo": {
    "type": "class",
    "new": true,
    "remote": true,
    "fields": {
      "cumulative_payout": "u128",
      "remaining_rewards": "u128"
    }
  },
  "RoundTimeInfo": {
    "type": "class",
    "new": true,
    "remote": true,
    "fields": {
      "last_update": "u64",
      "epoch_end": "u64"
    }
  },
  "RewardDistributorState": {
    "type": "class",
    "new": true,
    "remote": true,
    "fields": {
      "total_reserves": "u64",
      "active_shares": "u64",
      "round_reward_info": "RoundRewardInfo",
      "round_time_info": "RoundTimeInfo"
    },
    "methods": {
      "initial": {
        "type": "factory",
        "args": {
          "first_epoch_start": "u64"
        }
      }
    }
  },
  "RewardDistributorStateTransition": {
    "type": "class",
    "remote": true,
    "fields": {
      "old_state": "RewardDistributorState",
      "new_state": "RewardDistributorState"
    }
  },
  "RewardDistributorNftStakeEntry": {
    "type": "class",
    "remote": true,
    "fields": {
      "launcher_id": "Bytes32",
      "shares": "u64"
    }
  },
  "RewardDistributorAddEntryActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "created_entry_slot": "RewardDistributorEntrySlotValue",
      "manager_singleton_inner_puzzle_hash": "Bytes32",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorRemoveEntryActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_entry_slot": "RewardDistributorEntrySlotValue",
      "manager_singleton_inner_puzzle_hash": "Bytes32",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorAddIncentivesActionLog": {
