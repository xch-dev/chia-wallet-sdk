    }
  },
  "RewardDistributorCommitIncentivesActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_reward_slot": "RewardDistributorRewardSlotValue",
      "created_commitment_slot": "RewardDistributorCommitmentSlotValue",
      "created_reward_slots": "Vec<RewardDistributorRewardSlotValue>",
