    }
  },
  "RewardDistributorStakeCuratedNftsResult": {
    "type": "class",
    "fields": {
      "conditions": "Vec<Program>",
      "notarized_payments": "Vec<NotarizedPayment>",
      "new_nfts": "Vec<Nft>"
    }
  },
