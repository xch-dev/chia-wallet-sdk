{
  "RewardDistributorType": {
    "type": "class",
    "doc": "specifies the managed, NFT collection, curated NFT, or CAT reward distributor configuration.",
    "methods": {
      "managed": {
        "type": "static",
        "args": {
          "manager_singleton_launcher_id": "Bytes32"
        },
        "return": "RewardDistributorType"
      },
      "nft_collection": {
        "type": "static",
        "args": {
          "collection_did_launcher_id": "Bytes32"
        },
        "return": "RewardDistributorType"
      },
      "curated_nft": {
        "type": "static",
        "args": {
          "store_launcher_id": "Bytes32",
          "refreshable": "bool"
        },
        "return": "RewardDistributorType"
      },
      "cat": {
        "type": "static",
        "args": {
          "asset_id": "Bytes32",
          "hidden_puzzle_hash": "Option<Bytes32>"
        },
        "return": "RewardDistributorType"
      }
    }
  },
  "RewardDistributorConstants": {
    "type": "class",
    "doc": "holds the immutable configuration parameters for a reward distributor singleton.",
    "remote": true,
    "fields": {
      "launcher_id": "Bytes32",
      "fee_payout_puzzle_hash": "Bytes32",
      "epoch_seconds": "u64",
      "precision": "u64",
      "max_seconds_offset": "u64",
      "payout_threshold": "u64",
      "require_payout_approval": "bool",
      "fee_bps": "u64",
      "withdrawal_share_bps": "u64",
      "reserve_asset_id": "Bytes32",
      "reserve_inner_puzzle_hash": "Bytes32",
      "reserve_full_puzzle_hash": "Bytes32"
    },
    "methods": {
      "without_launcher_id": {
        "doc": "creates reward distributor constants before the launcher ID is known (pre-launch).",
        "type": "factory",
        "args": {
          "reward_distributor_type": "RewardDistributorType",
          "fee_payout_puzzle_hash": "Bytes32",
          "epoch_seconds": "u64",
          "precision": "u64",
          "max_seconds_offset": "u64",
          "payout_threshold": "u64",
          "require_payout_approval": "bool",
          "fee_bps": "u64",
          "withdrawal_share_bps": "u64",
          "reserve_asset_id": "Bytes32"
        }
      },
      "with_launcher_id": {
        "doc": "returns a copy of these constants with the launcher ID filled in after launch.",
        "args": {
          "launcher_id": "Bytes32"
        },
        "return": "RewardDistributorConstants"
      },
      "reward_distributor_type": {
        "return": "RewardDistributorType"
      }
    }
  },
  "RoundRewardInfo": {
    "type": "class",
    "doc": "tracks the cumulative payout and remaining rewards for the current distribution round.",
    "new": true,
    "remote": true,
    "fields": {
      "cumulative_payout": "u128",
      "remaining_rewards": "u128"
    }
  },
  "RoundTimeInfo": {
    "type": "class",
    "doc": "tracks the timing state of a reward distribution round (last update and epoch end timestamps).",
    "new": true,
    "remote": true,
    "fields": {
      "last_update": "u64",
      "epoch_end": "u64"
    }
  },
  "RewardDistributorState": {
    "type": "class",
    "doc": "holds the mutable state of a reward distributor: total reserves, active shares, and current round info.",
    "new": true,
    "remote": true,
    "fields": {
      "total_reserves": "u64",
      "active_shares": "u64",
      "round_reward_info": "RoundRewardInfo",
      "round_time_info": "RoundTimeInfo"
    },
    "methods": {
      "initial": {
        "type": "factory",
        "args": {
          "first_epoch_start": "u64"
        }
      }
    }
  },
  "RewardDistributorLauncherSolutionInfo": {
    "type": "class",
    "doc": "holds the parsed information from a reward distributor launcher solution: constants, initial state, and eve coin.",
    "new": true,
    "fields": {
      "constants": "RewardDistributorConstants",
      "initial_state": "RewardDistributorState",
      "coin": "Coin"
    }
  },
  "RewardDistributorFinishedSpendResult": {
    "type": "class",
    "doc": "holds the result of finishing a reward distributor spend: the updated distributor and the aggregated signature.",
    "new": true,
    "fields": {
      "new_distributor": "RewardDistributor",
      "signature": "Signature"
    }
  },
  "RewardDistributorRewardSlotValue": {
    "type": "class",
    "doc": "holds the value stored in a reward slot: the epoch start time, initialization flag, and reward amount.",
    "new": true,
    "remote": true,
    "fields": {
      "counter": "u64",
      "epoch_start": "u64",
      "next_epoch_initialized": "bool",
      "rewards": "u64"
    }
  },
  "RewardSlot": {
    "type": "class",
    "doc": "represents a reward slot coin in the reward distributor, tracking rewards available for a specific epoch.",
    "fields": {
      "coin": "Coin",
      "proof": "LineageProof",
      "nonce": "u64",
      "launcher_id": "Bytes32",
      "value": "RewardDistributorRewardSlotValue"
    },
    "methods": {
      "new": {
        "doc": "creates a new RewardSlot from its lineage proof, distributor launcher ID, and slot value.",
        "type": "factory",
        "args": {
          "proof": "LineageProof",
          "launcher_id": "Bytes32",
          "value": "RewardDistributorRewardSlotValue"
        }
      },
      "value_hash": {
        "doc": "returns the hash of this slot's value, used for on-chain verification.",
        "return": "Bytes32"
      }
    }
  },
  "RewardDistributorCommitmentSlotValue": {
    "type": "class",
    "doc": "holds the value stored in a commitment slot: epoch start, clawback puzzle hash, and committed reward amount.",
    "new": true,
    "remote": true,
    "fields": {
      "epoch_start": "u64",
      "clawback_ph": "Bytes32",
      "rewards": "u64"
    }
  },
  "CommitmentSlot": {
    "type": "class",
    "doc": "represents a commitment slot coin that locks incentive rewards for a specific epoch in the distributor.",
    "fields": {
      "coin": "Coin",
      "proof": "LineageProof",
      "nonce": "u64",
      "launcher_id": "Bytes32",
      "value": "RewardDistributorCommitmentSlotValue"
    },
    "methods": {
      "new": {
        "doc": "creates a new CommitmentSlot from its lineage proof, distributor launcher ID, and slot value.",
        "type": "factory",
        "args": {
          "proof": "LineageProof",
          "launcher_id": "Bytes32",
          "value": "RewardDistributorCommitmentSlotValue"
        }
      },
      "value_hash": {
        "doc": "returns the hash of this slot's value, used for on-chain verification.",
        "return": "Bytes32"
      }
    }
  },
  "RewardDistributorEntrySlotValue": {
    "type": "class",
    "doc": "holds the value stored in an entry slot: the staker's payout puzzle hash, initial cumulative payout, and share count.",
    "new": true,
    "remote": true,
    "fields": {
      "counter": "u64",
      "payout_puzzle_hash": "Bytes32",
      "initial_cumulative_payout": "u128",
      "shares": "u64"
    }
  },
  "EntrySlot": {
    "type": "class",
    "doc": "represents an entry slot coin for a staker in the reward distributor, tracking their shares and payout state.",
    "fields": {
      "coin": "Coin",
      "proof": "LineageProof",
      "nonce": "u64",
      "launcher_id": "Bytes32",
      "value": "RewardDistributorEntrySlotValue"
    },
    "methods": {
      "new": {
        "doc": "creates a new EntrySlot from its lineage proof, distributor launcher ID, and slot value.",
        "type": "factory",
        "args": {
          "proof": "LineageProof",
          "launcher_id": "Bytes32",
          "value": "RewardDistributorEntrySlotValue"
        }
      },
      "value_hash": {
        "doc": "returns the hash of this slot's value, used for on-chain verification.",
        "return": "Bytes32"
      }
    }
  },
  "RewardDistributorInitiatePayoutResult": {
    "type": "class",
    "doc": "holds the result of initiating a reward payout: the conditions to include and the payout amount.",
    "fields": {
      "conditions": "Vec<Program>",
      "payout_amount": "u64"
    }
  },
  "RewardDistributorNewEpochResult": {
    "type": "class",
    "doc": "holds the result of starting a new epoch: the conditions to include and the epoch fee amount.",
    "fields": {
      "conditions": "Vec<Program>",
      "epoch_fee": "u64"
    }
  },
  "RewardDistributorWithdrawIncentivesResult": {
    "type": "class",
    "doc": "holds the result of withdrawing committed incentives: the conditions and the withdrawn amount.",
    "fields": {
      "conditions": "Vec<Program>",
      "withdrawn_amount": "u64"
    }
  },
  "RewardDistributorRemoveEntryResult": {
    "type": "class",
    "doc": "holds the result of removing a staker entry: the conditions and the final payment amount.",
    "fields": {
      "conditions": "Vec<Program>",
      "last_payment_amount": "u64"
    }
  },
  "IntermediaryCoinProof": {
    "type": "class",
    "doc": "proves an intermediary coin in the NFT launcher proof chain for NFT-based reward distributors.",
    "new": true,
    "remote": true,
    "fields": {
      "full_puzzle_hash": "Bytes32",
      "amount": "u64"
    }
  },
  "NftLauncherProof": {
    "type": "class",
    "doc": "proves that an NFT belongs to a specific DID collection, used for NFT-based staking authorization.",
    "new": true,
    "remote": true,
    "fields": {
      "did_proof": "CompactLineageProof",
      "intermediary_coin_proofs": "Vec<IntermediaryCoinProof>"
    }
  },
  "RewardDistributorLaunchResult": {
    "type": "class",
    "doc": "holds the result of launching a new reward distributor: security keys, the distributor, first epoch slot, and refunded CAT.",
    "new": true,
    "fields": {
      "security_signature": "Signature",
      "security_secret_key": "SecretKey",
      "reward_distributor": "RewardDistributor",
      "first_epoch_slot": "RewardSlot",
      "refunded_cat": "Cat"
    }
  },
  "RewardDistributorInfoFromLauncher": {
    "type": "class",
    "doc": "holds the parsed reward distributor info from a launcher coin: constants, initial state, and eve singleton.",
    "new": true,
    "fields": {
      "constants": "RewardDistributorConstants",
      "initial_state": "RewardDistributorState",
      "eve_singleton": "Coin"
    }
  },
  "RewardDistributorInfoFromEveCoin": {
    "type": "class",
    "doc": "holds the parsed reward distributor info from the eve coin: the distributor and its first reward slot.",
    "new": true,
    "fields": {
      "distributor": "RewardDistributor",
      "first_reward_slot": "RewardSlot"
    }
  },
  "RewardDistributor": {
    "type": "class",
    "doc": "represents a reward distributor singleton that manages epoch-based reward distribution to stakers.",
    "methods": {
      "coin": {
        "doc": "returns the current coin of the reward distributor singleton.",
        "return": "Coin"
      },
      "proof": {
        "doc": "returns the lineage proof for the reward distributor singleton.",
        "return": "Proof"
      },
      "state": {
        "doc": "returns the current mutable state of the reward distributor.",
        "return": "RewardDistributorState"
      },
      "constants": {
        "doc": "returns the immutable configuration constants of the reward distributor.",
        "return": "RewardDistributorConstants"
      },
      "inner_puzzle_hash": {
        "doc": "returns the inner puzzle hash of the reward distributor singleton.",
        "return": "TreeHash"
      },
      "puzzle_hash": {
        "doc": "returns the full puzzle hash (including singleton wrapper) of the reward distributor.",
        "return": "TreeHash"
      },
      "reserve_coin": {
        "doc": "returns the CAT reserve coin held by the reward distributor.",
        "return": "Coin"
      },
      "reserve_asset_id": {
        "doc": "returns the asset ID (TAIL hash) of the CAT used as the reserve token.",
        "return": "Bytes32"
      },
      "reserve_proof": {
        "doc": "returns the lineage proof for the reserve CAT coin.",
        "return": "LineageProof"
      },
      "pending_created_reward_slots": {
        "doc": "returns reward slots that were created during the current spend but not yet confirmed.",
        "return": "Vec<RewardSlot>"
      },
      "pending_created_commitment_slots": {
        "doc": "returns commitment slots that were created during the current spend but not yet confirmed.",
        "return": "Vec<CommitmentSlot>"
      },
      "pending_created_entry_slots": {
        "doc": "returns entry slots that were created during the current spend but not yet confirmed.",
        "return": "Vec<EntrySlot>"
      },
      "pending_signature": {
        "doc": "returns the BLS signature accumulated during the current spend for security assertions.",
        "return": "Signature"
      },
      "reserve_full_puzzle_hash": {
        "doc": "computes the full puzzle hash of the reserve CAT for a given distributor and nonce.",
        "type": "static",
        "args": {
          "asset_id": "Bytes32",
          "distributor_launcher_id": "Bytes32",
          "nonce": "u64"
        },
        "return": "TreeHash"
      },
      "parse_launcher_solution": {
        "doc": "parses a reward distributor launcher solution to extract the configuration and initial state.",
        "type": "static",
        "args": {
          "launcher_coin": "Coin",
          "launcher_solution": "Program"
        },
        "return": "Option<RewardDistributorInfoFromLauncher>"
      },
      "finish_spend": {
        "doc": "finalizes the current reward distributor spend, returning the updated distributor and aggregated signature.",
        "args": {
          "other_cat_spends": "Vec<CatSpend>"
        },
        "return": "RewardDistributorFinishedSpendResult"
      },
      "add_incentives": {
        "doc": "adds incentive rewards to the distributor's reserve, returning the conditions to include.",
        "args": {
          "amount": "u64"
        },
        "return": "Vec<Program>"
      },
      "commit_incentives": {
        "doc": "commits incentive rewards to a specific epoch via a reward slot, creating a commitment slot.",
        "args": {
          "reward_slot": "RewardSlot",
          "epoch_start": "u64",
          "clawback_ph": "Bytes32",
          "rewards_to_add": "u64"
        },
        "return": "Vec<Program>"
      },
      "initiate_payout": {
        "doc": "initiates a reward payout to a staker based on their entry slot's accumulated rewards.",
        "args": {
          "entry_slot": "EntrySlot"
        },
        "return": "RewardDistributorInitiatePayoutResult"
      },
      "new_epoch": {
        "doc": "transitions the distributor to a new epoch, collecting the epoch fee and resetting reward tracking.",
        "args": {
          "reward_slot": "RewardSlot"
        },
        "return": "RewardDistributorNewEpochResult"
      },
      "sync": {
        "doc": "syncs the distributor's reward calculations to the given timestamp.",
        "args": {
          "update_time": "u64"
        },
        "return": "Vec<Program>"
      },
      "withdraw_incentives": {
        "doc": "withdraws previously committed incentives using the commitment slot and reward slot proofs.",
        "args": {
          "commitment_slot": "CommitmentSlot",
          "reward_slot": "RewardSlot"
        },
        "return": "RewardDistributorWithdrawIncentivesResult"
      },
      "add_entry": {
        "doc": "adds a new staker entry to the distributor with the given payout address, share count, and manager proof.",
        "args": {
          "payout_puzzle_hash": "Bytes32",
          "shares": "u64",
          "manager_singleton_inner_puzzle_hash": "Bytes32"
        },
        "return": "Vec<Program>"
      },
      "remove_entry": {
        "doc": "removes a staker entry from the distributor, paying out any remaining rewards.",
        "args": {
          "entry_slot": "EntrySlot",
          "manager_singleton_inner_puzzle_hash": "Bytes32"
        },
        "return": "RewardDistributorRemoveEntryResult"
      },
      "locked_nft_hint": {
        "doc": "computes the hint used to identify locked NFTs belonging to this distributor.",
        "type": "static",
        "args": {
          "distributor_launcher_id": "Bytes32",
          "custody_puzzle_hash": "Bytes32"
        },
        "return": "Bytes32"
      },
      "pending_created_deposit_slots": {
        "return": "Vec<DepositSlot>"
      },
      "pending_logs": {
        "return": "Vec<RewardDistributorActionLog>"
      },
      "stake_collection_nfts": {
        "args": {
          "offered_nfts": "Vec<Nft>",
          "nft_launcher_proofs": "Vec<NftLauncherProof>",
          "entry_custody_puzzle_hash": "Bytes32",
          "existing_slot": "Option<EntrySlot>"
        },
        "return": "RewardDistributorStakeCollectionNftsResult"
      },
      "stake_curated_nfts": {
        "args": {
          "offered_nfts": "Vec<Nft>",
          "nft_shares": "Vec<u64>",
          "inclusion_proofs": "Vec<MerkleProof>",
          "entry_custody_puzzle_hash": "Bytes32",
          "existing_slot": "Option<EntrySlot>",
          "dl_root_hash": "Bytes32",
          "dl_metadata_rest_hash": "Option<Bytes32>",
          "dl_metadata_updater_hash_hash": "Bytes32",
          "dl_inner_puzzle_hash": "Bytes32"
        },
        "return": "RewardDistributorStakeCuratedNftsResult"
      },
      "stake_cat": {
        "args": {
          "offered_cat": "Cat",
          "entry_custody_puzzle_hash": "Bytes32",
          "existing_slot": "Option<EntrySlot>"
        },
        "return": "RewardDistributorStakeCatResult"
      },
      "unstake_locked_nfts": {
        "args": {
          "entry_slot": "EntrySlot",
          "locked_nfts": "Vec<Nft>",
          "locked_nft_shares": "Vec<u64>",
          "deposit_slots": "Vec<DepositSlot>"
        },
        "return": "RewardDistributorUnstakeLockedNftsResult"
      },
      "unstake_locked_cat": {
        "args": {
          "entry_slot": "EntrySlot",
          "locked_cat": "Cat",
          "deposit_slot": "DepositSlot"
        },
        "return": "RewardDistributorUnstakeLockedCatResult"
      },
      "refresh_nfts": {
        "args": {
          "refresh_nfts_infos": "Vec<RefreshNftsInfo>",
          "dl_root_hash": "Bytes32",
          "dl_metadata_rest_hash": "Option<Bytes32>",
          "dl_metadata_updater_hash_hash": "Bytes32",
          "dl_inner_puzzle_hash": "Bytes32"
        },
        "return": "RewardDistributorRefreshNftsResult"
      }
    }
  },
  "RewardDistributorStateTransition": {
    "type": "class",
    "remote": true,
    "fields": {
      "old_state": "RewardDistributorState",
      "new_state": "RewardDistributorState"
    }
  },
  "RewardDistributorNftStakeEntry": {
    "type": "class",
    "remote": true,
    "fields": {
      "launcher_id": "Bytes32",
      "shares": "u64"
    }
  },
  "RewardDistributorAddEntryActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "created_entry_slot": "RewardDistributorEntrySlotValue",
      "manager_singleton_inner_puzzle_hash": "Bytes32",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorRemoveEntryActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_entry_slot": "RewardDistributorEntrySlotValue",
      "manager_singleton_inner_puzzle_hash": "Bytes32",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorAddIncentivesActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "amount": "u64",
      "manager_fee": "u64",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorCommitIncentivesActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_reward_slot": "RewardDistributorRewardSlotValue",
      "created_commitment_slot": "RewardDistributorCommitmentSlotValue",
      "created_reward_slots": "Vec<RewardDistributorRewardSlotValue>",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorInitiatePayoutActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_entry_slot": "RewardDistributorEntrySlotValue",
      "created_entry_slot": "RewardDistributorEntrySlotValue",
      "entry_payout_amount": "u64",
      "payout_rounding_error": "u128",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorNewEpochActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_reward_slot": "RewardDistributorRewardSlotValue",
      "created_reward_slot": "RewardDistributorRewardSlotValue",
      "epoch_total_rewards": "u64",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorSyncActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "update_time": "u64",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorWithdrawIncentivesActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_reward_slot": "RewardDistributorRewardSlotValue",
      "spent_commitment_slot": "RewardDistributorCommitmentSlotValue",
      "created_reward_slot": "RewardDistributorRewardSlotValue",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorRefreshNftsFromDlActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_entry_slots": "Vec<RewardDistributorEntrySlotValue>",
      "created_entry_slots": "Vec<RewardDistributorEntrySlotValue>",
      "spent_deposit_slots": "Vec<RewardDistributorDepositSlotValue>",
      "created_deposit_slots": "Vec<RewardDistributorDepositSlotValue>",
      "nft_entries": "Vec<RewardDistributorNftStakeEntry>",
      "dl_root_hash": "Bytes32",
      "dl_inner_puzzle_hash": "Bytes32",
      "dl_full_puzzle_hash": "Bytes32",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorStakeActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_entry_slot": "Option<RewardDistributorEntrySlotValue>",
      "created_entry_slot": "RewardDistributorEntrySlotValue",
      "created_deposit_slots": "Vec<RewardDistributorDepositSlotValue>",
      "cat_amount": "Option<u64>",
      "nft_entries": "Option<Vec<RewardDistributorNftStakeEntry>>",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorUnstakeActionLog": {
    "type": "class",
    "remote": true,
    "fields": {
      "spent_entry_slot": "RewardDistributorEntrySlotValue",
      "created_entry_slot": "RewardDistributorEntrySlotValue",
      "spent_deposit_slots": "Vec<RewardDistributorDepositSlotValue>",
      "cat_amount": "Option<u64>",
      "nft_entries": "Option<Vec<RewardDistributorNftStakeEntry>>",
      "changes": "RewardDistributorStateTransition"
    }
  },
  "RewardDistributorActionLog": {
    "type": "class",
    "fields": {
      "kind": "String",
      "add_entry": "Option<RewardDistributorAddEntryActionLog>",
      "remove_entry": "Option<RewardDistributorRemoveEntryActionLog>",
      "add_incentives": "Option<RewardDistributorAddIncentivesActionLog>",
      "commit_incentives": "Option<RewardDistributorCommitIncentivesActionLog>",
      "initiate_payout": "Option<RewardDistributorInitiatePayoutActionLog>",
      "new_epoch": "Option<RewardDistributorNewEpochActionLog>",
      "sync": "Option<RewardDistributorSyncActionLog>",
      "withdraw_incentives": "Option<RewardDistributorWithdrawIncentivesActionLog>",
      "refresh_nfts_from_dl": "Option<RewardDistributorRefreshNftsFromDlActionLog>",
      "stake": "Option<RewardDistributorStakeActionLog>",
      "unstake": "Option<RewardDistributorUnstakeActionLog>"
    }
  },
  "RewardDistributorDepositSlotValue": {
    "type": "class",
    "remote": true,
    "fields": {
      "payout_puzzle_hash": "Bytes32",
      "shares": "u64"
    },
    "methods": {
      "nft": {
        "type": "factory",
