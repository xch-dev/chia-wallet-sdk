    "type": "class",
    "new": true,
    "remote": true,
    "fields": {
      "parent_parent_coin_info": "Bytes32",
      "parent_inner_puzzle_hash": "Bytes32",
      "parent_amount": "u64"
    },
    "methods": {
      "from_lineage_proof": {
        "type": "factory",
        "args": {
          "proof": "LineageProof"
        }
      }
    }
  },
  "NftLauncherProof": {
    "type": "class",
    "new": true,
    "remote": true,
    "fields": {
      "did_proof": "CompactLineageProof",
