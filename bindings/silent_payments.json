{
  "SilentPaymentNetwork": {
    "type": "enum",
    "values": ["Mainnet", "Testnet"]
  },
  "SilentPaymentAddress": {
    "type": "class",
    "new": true,
    "fields": {
      "scan_pk": "PublicKey",
      "spend_pk": "PublicKey",
      "network": "SilentPaymentNetwork"
    },
    "methods": {
      "encode": {
        "return": "String"
      },
      "decode": {
        "type": "factory",
        "args": {
          "address": "String"
        }
      }
    }
  },
  "SilentPaymentKeys": {
    "type": "class",
    "methods": {
      "from_mnemonic": {
        "type": "factory",
        "args": {
          "mnemonic": "Mnemonic"
        }
      },
      "from_secret_keys": {
        "type": "factory",
        "args": {
          "scan_sk": "SecretKey",
          "spend_sk": "SecretKey"
        }
      },
      "scan_sk": {
        "return": "SecretKey"
      },
      "spend_sk": {
        "return": "SecretKey"
      },
      "scan_pk": {
        "return": "PublicKey"
      },
      "spend_pk": {
        "return": "PublicKey"
      },
      "unlabeled_address": {
        "args": {
          "network": "SilentPaymentNetwork"
        },
        "return": "SilentPaymentAddress"
      },
      "labeled_address": {
        "args": {
          "network": "SilentPaymentNetwork",
          "m": "u32"
        },
        "return": "SilentPaymentAddress"
      },
      "change_address": {
        "args": {
          "network": "SilentPaymentNetwork"
        },
        "return": "SilentPaymentAddress"
      }
    }
  },
  "LabelRegistry": {
    "type": "class",
    "methods": {
      "new": {
        "type": "constructor"
      },
      "register": {
        "args": {
          "scan_sk": "SecretKey",
          "m": "u32"
        }
      },
      "forward": {
        "args": {
          "m": "u32"
        },
        "return": "Option<PublicKey>"
      },
      "lookup": {
        "args": {
          "label_pk": "PublicKey"
        },
        "return": "Option<u32>"
      },
      "len": {
        "return": "u32"
      },
      "is_empty": {
        "return": "bool"
      }
    }
  },
  "OutputMeta": {
    "type": "class",
    "new": true,
    "fields": {
      "puzzle_hash": "Bytes32",
      "coin_id": "Bytes32",
      "amount": "u64",
      "parent_coin_id": "Bytes32"
    }
  },
  "SilentPaymentWrapper": {
    "type": "class",
    "new": true,
    "fields": {
      "asset_id": "Bytes32",
      "hidden_puzzle_hash": "Option<Bytes32>"
    },
    "methods": {
      "wrap": {
        "args": {
          "puzzle_hash": "Bytes32"
        },
        "return": "Bytes32"
      }
    }
  },
  "TweakData": {
    "type": "class",
    "fields": {
      "tweak_points": "Vec<PublicKey>",
      "outputs": "Vec<OutputMeta>",
      "wrappers": "Vec<SilentPaymentWrapper>"
    },
    "methods": {
      "new": {
        "type": "constructor",
        "args": {
          "tweak_points": "Vec<PublicKey>",
          "outputs": "Vec<OutputMeta>"
        }
      },
      "with_wrappers": {
        "type": "factory",
        "args": {
          "tweak_points": "Vec<PublicKey>",
          "outputs": "Vec<OutputMeta>",
          "wrappers": "Vec<SilentPaymentWrapper>"
        }
      }
    }
  },
  "DetectedSpCoin": {
    "type": "class",
    "new": true,
    "fields": {
      "coin_id": "Bytes32",
      "puzzle_hash": "Bytes32",
      "amount": "u64",
      "parent_coin_id": "Bytes32",
      "k": "u32",
      "label": "Option<u32>",
      "tweak": "ScalarField",
      "wrapper": "Option<SilentPaymentWrapper>"
    },
    "methods": {
      "coin": {
        "return": "Coin"
      },
      "onetime_sk": {
        "args": {
          "spend_sk": "SecretKey"
        },
        "return": "SecretKey"
      }
    }
  },
  "ScalarField": {
    "type": "class",
    "methods": {
      "from_bytes": {
        "type": "factory",
        "args": {
          "bytes": "Bytes32"
        }
      },
      "to_bytes": {
        "return": "Bytes32"
      }
    }
  },
  "SilentPaymentLabel": {
    "type": "class",
    "new": true,
    "fields": {
      "scalar": "ScalarField",
      "public_key": "PublicKey"
    }
  },
  "SilentPaymentRegisteredKey": {
    "type": "class",
    "new": true,
    "fields": {
      "p2_puzzle_hash": "Bytes32",
      "public_key": "PublicKey"
    }
  },
  "SilentPaymentRegisteredSecretKey": {
    "type": "class",
    "new": true,
    "fields": {
      "p2_puzzle_hash": "Bytes32",
      "secret_key": "SecretKey"
    }
  },
  "SilentPaymentGroupCoin": {
    "type": "class",
    "new": true,
    "fields": {
      "coin_id": "Bytes32",
      "secret_key": "SecretKey",
      "wrapper": "Option<SilentPaymentWrapper>"
    }
  },
  "SilentPaymentSettlementRecipient": {
    "type": "class",
    "new": true,
    "fields": {
      "scan_pk": "PublicKey",
      "spend_pk": "PublicKey",
      "wrapper": "Option<SilentPaymentWrapper>",
      "settled": "bool",
      "amount": "u64"
    }
  },
  "SilentPaymentOtherPayment": {
    "type": "class",
    "new": true,
    "fields": {
      "wrapper": "Option<SilentPaymentWrapper>",
      "payment": "Bytes"
    }
  },
  "SilentPaymentGroupOutput": {
    "type": "class",
    "new": true,
    "fields": {
      "k": "u32",
      "wrapper": "Option<SilentPaymentWrapper>",
      "puzzle_hash": "Bytes32",
      "amount": "u64",
      "wrapped_puzzle_hash": "Bytes32"
    }
  },
  "SilentPaymentSettlement": {
    "type": "class",
    "new": true,
    "fields": {
      "settlement_outputs": "Vec<Bytes32>",
      "announcements": "Vec<Bytes32>",
      "settled_payments": "Vec<Bytes>",
      "notarized_payments": "Vec<Bytes>",
      "group_outputs": "Vec<SilentPaymentGroupOutput>"
    }
  },
  "SilentPayments": {
    "type": "class",
    "methods": {
      "k_max": {
        "type": "static",
        "return": "u32"
      },
      "scan_from_tweaks": {
        "type": "static",
        "args": {
          "scan_sk": "SecretKey",
          "spend_pk": "PublicKey",
          "data": "TweakData",
          "labels": "LabelRegistry",
          "k_max": "u32"
        },
        "return": "Vec<DetectedSpCoin>"
      },
      "generate_label": {
        "type": "static",
        "args": {
          "scan_sk": "SecretKey",
          "m": "u32"
        },
        "return": "SilentPaymentLabel"
      },
      "derive_onetime_sk": {
        "type": "static",
        "args": {
          "spend_sk": "SecretKey",
          "tweak": "ScalarField"
        },
        "return": "SecretKey"
      },
      "derive_one_time_puzzle_hash": {
        "type": "static",
        "args": {
          "scan_pk": "PublicKey",
          "spend_pk": "PublicKey",
          "aggregated_sender_sk": "SecretKey",
          "input_hash": "ScalarField",
          "k": "u32"
        },
        "return": "Bytes32"
      },
      "compute_input_hash": {
        "type": "static",
        "args": {
          "coin_ids": "Vec<Bytes32>",
          "aggregated_sender_pk": "PublicKey"
        },
        "return": "ScalarField"
      },
      "compute_tweak_point": {
        "type": "static",
        "args": {
          "coin_ids": "Vec<Bytes32>",
          "aggregated_sender_pk": "PublicKey"
        },
        "return": "Option<PublicKey>"
      },
      "aggregate_sender_sks": {
        "type": "static",
        "args": {
          "sks": "Vec<SecretKey>"
        },
        "return": "SecretKey"
      },
      "tweak_data_from_block_spends": {
        "type": "static",
        "args": {
          "coin_spends": "Vec<CoinSpend>",
          "additions": "Vec<Coin>"
        },
        "return": "TweakData"
      },
      "derive_settlement_outputs": {
        "type": "static",
        "args": {
          "group": "Vec<SilentPaymentGroupCoin>",
          "recipients": "Vec<SilentPaymentSettlementRecipient>",
          "other_payments": "Vec<SilentPaymentOtherPayment>",
          "nonce": "Bytes32"
        },
        "return": "SilentPaymentSettlement"
      }
    }
  }
}
