{
  "Spends": {
    "type": "class",
    "methods": {
      "new": {
        "args": {
          "clvm": "Clvm",
          "change_puzzle_hash": "Bytes32"
        },
        "type": "constructor"
      },
      "with_separate_change_puzzle_hash": {
        "type": "factory",
        "args": {
          "clvm": "Clvm",
          "intermediate_puzzle_hash": "Bytes32",
          "change_puzzle_hash": "Bytes32"
        }
      },
      "add_xch": {
        "args": {
          "coin": "Coin"
        }
      },
      "add_cat": {
        "args": {
          "cat": "Cat"
        }
      },
      "add_cat_for_revocation": {
        "args": {
          "cat": "Cat"
        }
      },
      "add_offered_coins": {
        "args": {
          "offer": "Offer"
        }
      },
      "add_did": {
        "args": {
          "did": "Did"
        }
      },
      "add_nft": {
        "args": {
          "nft": "Nft"
        }
      },
      "add_option": {
        "args": {
          "option": "OptionContract"
        }
      },
      "p2_puzzle_hashes": {
        "return": "Vec<Bytes32>"
      },
      "non_settlement_coin_ids": {
        "return": "Vec<Bytes32>"
      },
      "add_optional_condition": {
        "args": {
          "condition": "Program"
        }
      },
      "add_required_condition": {
        "args": {
          "condition": "Program"
        }
      },
      "disable_settlement_assertions": {},
      "selected_xch_amount": {
        "return": "u128"
      },
      "selected_asset_ids": {
        "return": "Vec<Bytes32>"
      },
      "selected_cat_amount": {
        "args": {
          "asset_id": "Bytes32"
        },
        "return": "u128"
      },
      "apply": {
        "args": {
          "actions": "Vec<Action>"
        },
        "return": "Deltas"
      },
      "prepare": {
        "args": {
          "deltas": "Deltas",
          "relation": "Option<Relation>"
        },
        "return": "FinishedSpends"
      },
      "with_silent_payment_keys": {
        "args": {
          "synthetic_pks": "Vec<SilentPaymentRegisteredKey>",
          "secret_keys": "Vec<SilentPaymentRegisteredSecretKey>"
        }
      }
    }
  },
  "Relation": {
    "type": "enum",
    "values": [
      "Unrelated",
      "AssertConcurrent",
      "CoinAnnouncementRing",
      "CoinAnnouncementHub"
    ]
  },
  "FinishedSpends": {
    "type": "class",
    "methods": {
      "pending_spends": {
        "return": "Vec<PendingSpend>"
      },
      "insert": {
        "args": {
          "coin_id": "Bytes32",
          "spend": "Spend"
        }
      },
      "spend": {
        "return": "Outputs"
      }
    }
  },
  "PendingSpend": {
    "type": "class",
    "methods": {
      "p2_puzzle_hash": {
        "return": "Bytes32"
      },
      "coin": {
        "return": "Coin"
      },
      "conditions": {
        "return": "Vec<Program>"
      },
      "as_xch": {
        "return": "Option<Coin>"
      },
      "as_cat": {
        "return": "Option<Cat>"
      },
      "is_revocation": {
        "return": "bool"
      },
      "as_did": {
        "return": "Option<Did>"
      },
      "as_nft": {
        "return": "Option<Nft>"
      },
      "as_option": {
        "return": "Option<OptionContract>"
      }
    }
  },
  "Action": {
    "type": "class",
    "methods": {
      "send": {
        "type": "factory",
        "args": {
          "id": "Id",
          "puzzle_hash": "Bytes32",
          "amount": "u64",
          "memos": "Option<Program>"
        }
      },
      "burn": {
        "type": "factory",
        "args": {
          "id": "Id",
          "amount": "u64",
          "memos": "Option<Program>"
        }
      },
      "silent_payment_send": {
        "type": "factory",
        "args": {
          "recipient": "SilentPaymentAddress",
          "amount": "u64",
          "memos": "Option<Program>"
        }
      },
      "settle": {
        "type": "factory",
        "args": {
          "id": "Id",
          "notarized_payment": "NotarizedPayment"
        }
      },
      "settle_royalty": {
        "type": "factory",
        "args": {
          "clvm": "Clvm",
          "id": "Id",
          "launcher_id": "Bytes32",
          "royalty_puzzle_hash": "Bytes32",
          "royalty_amount": "u64"
        }
      },
      "create_did": {
        "type": "factory",
        "args": {
          "metadata": "Program",
          "recovery_list_hash": "Option<Bytes32>",
          "num_verifications_required": "u64",
          "amount": "u64"
        }
      },
      "create_empty_did": {
        "type": "factory"
      },
      "update_did": {
        "type": "factory",
        "args": {
          "id": "Id",
          "new_metadata": "Option<Program>",
          "new_recovery_list_hash": "Option<Bytes32>",
          "new_num_verifications_required": "Option<u64>",
          "remove_recovery_list_hash": "Option<bool>"
        }
      },
      "mint_option": {
        "type": "factory",
        "args": {
          "creator_puzzle_hash": "Bytes32",
          "seconds": "u64",
          "underlying_id": "Id",
          "underlying_amount": "u64",
          "strike_type": "OptionType",
          "amount": "u64"
        }
      },
      "melt_singleton": {
        "type": "factory",
        "args": {
          "id": "Id",
          "amount": "u64"
        }
      },
      "issue_cat": {
        "type": "factory",
        "args": {
          "tail_spend": "Spend",
          "hidden_puzzle_hash": "Option<Bytes32>",
          "amount": "u64"
        }
      },
      "single_issue_cat": {
        "type": "factory",
        "args": {
          "hidden_puzzle_hash": "Option<Bytes32>",
          "amount": "u64"
        }
      },
      "run_tail": {
        "type": "factory",
        "args": {
          "id": "Id",
          "tail_spend": "Spend",
          "supply_delta": "Delta"
        }
      },
      "mint_nft": {
        "type": "factory",
        "args": {
          "clvm": "Clvm",
          "metadata": "Program",
          "metadata_updater_puzzle_hash": "Bytes32",
          "royalty_puzzle_hash": "Bytes32",
          "royalty_basis_points": "u16",
          "amount": "u64",
          "parent_id": "Option<Id>"
        }
      },
      "update_nft": {
        "type": "factory",
        "args": {
          "id": "Id",
          "metadata_update_spends": "Vec<Spend>",
          "transfer": "Option<TransferNftById>"
        }
      },
      "fee": {
        "type": "factory",
        "args": {
          "amount": "u64"
        }
      }
    }
  },
  "Deltas": {
    "type": "class",
    "methods": {
      "from_actions": {
        "type": "static",
        "args": {
          "actions": "Vec<Action>"
        },
        "return": "Deltas"
      },
      "get": {
        "args": {
          "id": "Id"
        },
        "return": "Option<Delta>"
      },
      "is_needed": {
        "args": {
          "id": "Id"
        },
        "return": "bool"
      },
      "ids": {
        "return": "Vec<Id>"
      }
    }
  },
  "Delta": {
    "type": "class",
    "new": true,
    "remote": true,
    "fields": {
      "input": "u128",
      "output": "u128"
    }
  },
  "Id": {
    "type": "class",
    "methods": {
      "xch": {
        "type": "factory"
      },
      "existing": {
        "type": "factory",
        "args": {
          "asset_id": "Bytes32"
        }
      },
      "new": {
        "type": "factory",
        "args": {
          "index": "usize"
        }
      },
      "is_xch": {
        "return": "bool"
      },
      "as_existing": {
        "return": "Option<Bytes32>"
      },
      "as_new": {
        "return": "Option<usize>"
      },
      "equals": {
        "args": {
          "id": "Id"
        },
        "return": "bool"
      }
    }
  },
  "Outputs": {
    "type": "class",
    "methods": {
      "xch": {
        "return": "Vec<Coin>"
      },
      "cats": {
        "return": "Vec<Id>"
      },
      "cat": {
        "args": {
          "id": "Id"
        },
        "return": "Vec<Cat>"
      },
      "nfts": {
        "return": "Vec<Id>"
      },
      "nft": {
        "args": {
          "id": "Id"
        },
        "return": "Nft"
      },
      "dids": {
        "return": "Vec<Id>"
      },
      "did": {
        "args": {
          "id": "Id"
        },
        "return": "Did"
      },
      "options": {
        "return": "Vec<Id>"
      },
      "option": {
        "args": {
          "id": "Id"
        },
        "return": "OptionContract"
      },
      "fee": {
        "return": "u64"
      },
      "reserved_fee": {
        "return": "u64"
      }
    }
  },
  "TransferNftById": {
    "type": "class",
    "new": true,
    "fields": {
      "owner_id": "Option<Id>",
      "trade_prices": "Vec<TradePrice>"
    }
  }
}
