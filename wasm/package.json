{
  "scripts": {
    "build": "wasm-pack build",
    "pack": "wasm-pack pack",
    "test": "wasm-pack build --target nodejs && ava"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ava": "^8.0.1",
    "ts-node": "^10.9.2"
  },
  "ava": {
    "timeout": "3m",
    "extensions": [
      "ts"
    ],
    "require": [
      "ts-node/register"
    ]
  }
}
